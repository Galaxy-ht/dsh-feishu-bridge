{
  "name": "dsh-feishu-panel",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 飞书桥的控制面板：会话映射、弹窗位置、流式与展示、凭据与运行状态，全部图形化配置。",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "author": "DSH Feishu Bridge contributors",
  "homepage": "https://github.com/Galaxy-ht/dsh-feishu-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galaxy-ht/dsh-feishu-bridge.git",
    "directory": "packages/dsh-feishu-panel"
  },
  "bugs": {
    "url": "https://github.com/Galaxy-ht/dsh-feishu-bridge/issues"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
