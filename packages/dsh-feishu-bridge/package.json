{
  "name": "@ethanhale_/dsh-feishu-bridge",
  "version": "0.1.1",
  "type": "module",
  "description": "DSH ↔ 飞书：流式互动卡片 + 卡内审批 + 控制面板，二合一安装包。",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "card",
    "streaming",
    "approval",
    "bundle"
  ],
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./bridge": "./bridge/entry.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "bridge",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "author": "DSH Feishu Bridge contributors",
  "homepage": "https://github.com/Galaxy-ht/dsh-feishu-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Galaxy-ht/dsh-feishu-bridge.git",
    "directory": "packages/dsh-feishu-bridge"
  },
  "bugs": {
    "url": "https://github.com/Galaxy-ht/dsh-feishu-bridge/issues"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
